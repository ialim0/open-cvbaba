        <div class="entry">
            <div class="entry-header">
                <span>M.S. Computer Science, Stanford University</span>
                <span>2017</span>
            </div>
        </div>
        <div class="entry">
            <div class="entry-header">
                <span>B.S. Computer Science, UC Berkeley</span>
                <span>2015</span>
            </div>
        </div>
    </div>

    <div class="section">
        <div class="section-title">Skills</div>
        <div class="skills">
